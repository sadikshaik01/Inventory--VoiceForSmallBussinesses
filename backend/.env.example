# Read by Spring Boot when started with backend/ as the working directory.
# Standard environment variables override this local file.
PORT=8080
SPRING_PROFILES_ACTIVE=postgres
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Required: direct or SESSION pooler connection from your Supabase Connect panel.
# Use the exact host and database username shown there. No password in the URL.
# Use sslmode=require for Supabase (or verify-full with its CA certificate).
# Never use VITE_ prefixes for these backend-only credentials.
DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_POOL_SIZE=5

# Required: generate at least 32 random bytes and base64 encode them.
# Do not change this on each restart: existing tokens use this signing key.
JWT_SECRET=YOUR_BASE64_ENCODED_RANDOM_SIGNING_KEY
JWT_EXPIRATION_SECONDS=3600

# No external AI key is required: the deterministic multilingual parser is active.
# External LLM fallback is not configured in this release. Never add AI secrets to VITE_* variables.

